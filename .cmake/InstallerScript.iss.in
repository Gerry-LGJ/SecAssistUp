; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

#define MyAppName           "${PROJECT_NAME}"
#define MyAppVersion        "${GIT_SEMVER}"
#define MyAppFileVersion    "${GIT_SEMVER}.${GIT_COMMIT_COUNT}"
#define MyAppPublisher      "TimeChicken"
#define MyAppCopyright      "Copyright (C) 2023 TimeChicken. All rights reserved."
#define MyAppURL            "https://gitee.com/time--chicken/SecAssistPro"
#define MyAppExeName        "${PROJECT_NAME}.exe"
#define MyAppFileDir        "dist"
#define MyAppSourceDir      ".\.."
#define MySignTool          "mysigntool"
#define MyAppDataDir        "{localappdata}\TimeChicken\${PROJECT_NAME}"

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{693E34DD-2065-488E-B2C1-C91CBE20CAC8}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
AppCopyright={#MyAppCopyright}
VersionInfoVersion={#MyAppFileVersion}
DefaultDirName={autopf}\{#MyAppName}
UninstallDisplayIcon={app}\{#MyAppExeName}
DisableProgramGroupPage=yes
LicenseFile={#MyAppSourceDir}\License
; Uncomment the following line to run in non administrative install mode (install for current user only).
;PrivilegesRequired=lowest
OutputDir=.\
OutputBaseFilename={#MyAppName}-{#MyAppVersion}_setup
Compression=lzma
SetupIconFile={#MyAppSourceDir}\res\image\favicon_nbg.ico
SolidCompression=yes
WizardStyle=modern
; build x64
; "ArchitecturesAllowed=x64compatible" specifies that Setup cannot run
; on anything but x64 and Windows 11 on Arm.
; ArchitecturesAllowed=x64compatible
; "ArchitecturesInstallIn64BitMode=x64compatible" requests that the
; install be done in "64-bit mode" on x64 or Windows 11 on Arm,
; meaning it should use the native 64-bit Program Files directory and
; the 64-bit view of the registry.
; ArchitecturesInstallIn64BitMode=x64compatible
; sign tool
; SignTool={#MySignTool}
; SignedUninstaller=yes

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "chinesesimplified"; MessagesFile: "compiler:Languages\ChineseSimplified.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: checkablealone

[Files]
Source: "{#MyAppSourceDir}\{#MyAppFileDir}\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion signonce
Source: "{#MyAppSourceDir}\{#MyAppFileDir}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

[Registry]
; Delete the startup items for the current user
Root: HKCU; Subkey: "Software\Microsoft\Windows\CurrentVersion\Run"; ValueType: none; ValueName: "{#MyAppName}"; Flags: deletevalue uninsdeletevalue;

[Code]
function GetUILanguage: Integer;
external 'GetUserDefaultUILanguage@kernel32.dll stdcall';

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
  DataPath: String;
  MsgText:  String;
begin
  if CurUninstallStep = usUninstall then
  begin
    DataPath := ExpandConstant('{#MyAppDataDir}');

    if GetUILanguage = $0804 then
      MsgText := '是否保留个人数据？这包括您创建的所有工程和设置信息' + #13#10 +
                 '路径：' + DataPath + #13#10#13#10 +
                 '选择【是】将保留您的个人数据；' + #13#10 +
                 '选择【否】将清除所有个人数据。'
    else
      MsgText := 'Keep personal data? This includes all your projects and settings' + #13#10 +
                 'Path: ' + DataPath + #13#10#13#10 +
                 'Select [Yes] to keep your personal data;' + #13#10 +
                 'Select [No] to delete all personal data.'
    ;

    if MsgBox(MsgText, mbConfirmation, MB_YESNO) = IDNO then
    begin
      DelTree(DataPath, True, True, True);
    end;

  end;
end;

